{
  "kind": "collectionType",
  "collectionName": "assessments",
  "info": {
    "singularName": "assessment",
    "pluralName": "assessments",
    "displayName": "assessment"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "durationMinutes": {
      "type": "integer",
      "required": true
    },
    "tabSwitchLimit": {
      "type": "integer"
    },
    "autoSubmitOnTimeout": {
      "type": "boolean",
      "default": true
    },
    "questions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::question-bank.question-bank",
      "inversedBy": "assessments"
    },
    "shuffleQuestions": {
      "type": "boolean",
      "default": true
    },
    "shuffleOptions": {
      "type": "boolean",
      "default": true
    },
    "totalMarks": {
      "type": "integer"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization",
      "inversedBy": "assessments"
    },
    "createdByUser": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "assessments"
    },
    "publicLinkEnabled": {
      "type": "boolean"
    },
    "instructions": {
      "type": "blocks"
    }
  }
}
