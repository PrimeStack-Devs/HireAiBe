{
  "kind": "collectionType",
  "collectionName": "skills",
  "info": {
    "singularName": "skill",
    "pluralName": "skills",
    "displayName": "skill"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "technical",
        "hr",
        "aptitude",
        "soft-skills",
        "coding"
      ]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization",
      "inversedBy": "skills"
    },
    "questions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::question-bank.question-bank",
      "mappedBy": "skills"
    }
  }
}
